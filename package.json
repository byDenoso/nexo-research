{
  "name": "nexo-research",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run data:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
