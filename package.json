    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.5",
    "@react-three/fiber": "9.8.2",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "katex": "0.19.1",
    "motion": "14.14.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
